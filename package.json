{
  "name": "luthers-rosenkrans",
  "version": "1.0.0",
  "private": true,
  "description": "Luthers Rosenkrans — offline-first Swedish Lutheran rosary PWA",
  "type": "module",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "extract:scriptures": "node scripts/extract-scriptures.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "predev": "npm run extract:scriptures",
    "prebuild": "npm run extract:scriptures",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.js",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:unit && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@bubblewrap/cli": "^1.25.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "saxes": "^6.0.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "workbox-webpack-plugin": "^7.4.1"
  }
}
